# VeChain Network Configuration
# Copy this file to .env and fill in your actual values

# Private key for deployment (without 0x prefix for some tools, with 0x for others - check your tool requirements)
PRIVATE_KEY=your_private_key_here

# Testnet Configuration
TESTNET_RPC_URL=https://rpc-testnet.vechain.energy/
TESTNET_CHAIN_ID=39

# Mainnet Configuration  
MAINNET_RPC_URL=https://rpc-mainnet.vechain.energy/
MAINNET_CHAIN_ID=100009

# Optional: Gas configuration
GAS_LIMIT=8000000
GAS_PRICE=1000000000000

# Optional: Etherscan-like verification (if VeChain supports it)
# VECHAIN_API_KEY=your_api_key_here