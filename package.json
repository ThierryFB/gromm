{
  "name": "vechain-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "hardhat test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "compile": "hardhat compile",
    "deploy": "hardhat run blockchain/deploy.js --network vechain_testnet",
    "deploy:testnet": "hardhat run blockchain/deploy.js --network vechain_testnet",
    "deploy:mainnet": "hardhat run blockchain/deploy.js --network vechain_mainnet",
    "verify": "hardhat verify --network",
    "size": "hardhat size-contracts",
    "gas": "REPORT_GAS=true hardhat test"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "express": "^4.17.1",
    "thorify": "^1.5.3",
    "web3": "^1.3.0",
    "@vechain/connex-framework": "^2.0.12",
    "@vechain/connex-driver": "^2.0.12"
  },
  "devDependencies": {
    "hardhat": "^2.14.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-waffle": "^2.0.5",
    "hardhat-gas-reporter": "^1.0.9",
    "hardhat-contract-sizer": "^2.8.0",
    "@nomiclabs/hardhat-etherscan": "^3.1.7",
    "ethereum-waffle": "^3.4.4",
    "ethers": "^5.7.2",
    "chai": "^4.3.7",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.40.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.1.1",
    "solidity-coverage": "^0.8.2",
    "mockdate": "3.0.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "ts",
      "sol"
    ],
    "watchPathIgnorePatterns": [
      "./app/node_modules/",
      "./app/artifacts/"
    ]
  }
}
